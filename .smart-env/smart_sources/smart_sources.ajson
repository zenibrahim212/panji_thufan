"smart_sources:Literature/faedah_139_1.md": {"class_name":"SmartSource","last_read":{"hash":"1q0baku","at":1795258067224},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":219,"read_hash":"1q0baku","at":1795258080478}}},"path":"Literature/faedah_139_1.md","last_import":{"mtime":1794485099286,"size":237,"at":1795258067224,"hash":"1q0baku"},"outlinks":[],"blocks_data":{"#Bisa jadi kita memiliki kekuatan tetapi nihil nilainya tanpa Allah.":{"text":null,"length":0,"last_read":{"hash":"1q0baku","at":1795258067224},"key":"Literature/faedah_139_1.md#Bisa jadi kita memiliki kekuatan tetapi nihil nilainya tanpa Allah.","lines":[1,5],"size":200,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":243,"read_hash":"1q0baku","at":1795258080354}}}},"#Bisa jadi kita memiliki kekuatan tetapi nihil nilainya tanpa Allah.#{1}":{"text":null,"length":0,"last_read":{"hash":"7z8olc","at":1795258067224},"key":"Literature/faedah_139_1.md#Bisa jadi kita memiliki kekuatan tetapi nihil nilainya tanpa Allah.#{1}","lines":[3,5],"size":129,"should_embed":false}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_139_1.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_140.md": {"class_name":"SmartSource","last_read":{"hash":"rttf8t","at":1795258067225},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":245,"read_hash":"rttf8t","at":1795258089147}}},"path":"Literature/faedah_140.md","last_import":{"mtime":1794485694823,"size":2103,"at":1795258067226,"hash":"rttf8t"},"outlinks":[],"blocks_data":{"#Ketika di zaman kita seorang dai hanya memperhatikan dirinya sendiri dan mencari kenyamanan pribadi dengan mengesampingkan dakwahnya. Ketika ia berjuang mati-matian untuk memuaskan keegoisannya. Ketika jamaah-jamaah disibukkan dengan perkara furu' meninggalkan perkara-perkara besar. Ketika kita sibuk mengikuti pendapat-pendapat seseorang dan meninggalkan prinsip. Ketika kita sibuk dengan masalah-masalah khilafiyah dan meninggalkan prioritas tema dakwah seperti mewujudkan peribadatan, kewajiban menolong Al-Aqsha, tawanan dan orang-orang lemah serta tuntutan perlawanan pada fase ini... Maka bisa jadi Allah akan menghukum jamaah-jamaah atau para dai itu dan tidak menghukum masyarakat awam.":{"text":null,"length":0,"last_read":{"hash":"rttf8t","at":1795258067225},"key":"Literature/faedah_140.md#Ketika di zaman kita seorang dai hanya memperhatikan dirinya sendiri dan mencari kenyamanan pribadi dengan mengesampingkan dakwahnya. Ketika ia berjuang mati-matian untuk memuaskan keegoisannya. Ketika jamaah-jamaah disibukkan dengan perkara furu' meninggalkan perkara-perkara besar. Ketika kita sibuk mengikuti pendapat-pendapat seseorang dan meninggalkan prinsip. Ketika kita sibuk dengan masalah-masalah khilafiyah dan meninggalkan prioritas tema dakwah seperti mewujudkan peribadatan, kewajiban menolong Al-Aqsha, tawanan dan orang-orang lemah serta tuntutan perlawanan pada fase ini... Maka bisa jadi Allah akan menghukum jamaah-jamaah atau para dai itu dan tidak menghukum masyarakat awam.","lines":[1,5],"size":1787,"should_embed":false},"#Ketika di zaman kita seorang dai hanya memperhatikan dirinya sendiri dan mencari kenyamanan pribadi dengan mengesampingkan dakwahnya. Ketika ia berjuang mati-matian untuk memuaskan keegoisannya. Ketika jamaah-jamaah disibukkan dengan perkara furu' meninggalkan perkara-perkara besar. Ketika kita sibuk mengikuti pendapat-pendapat seseorang dan meninggalkan prinsip. Ketika kita sibuk dengan masalah-masalah khilafiyah dan meninggalkan prioritas tema dakwah seperti mewujudkan peribadatan, kewajiban menolong Al-Aqsha, tawanan dan orang-orang lemah serta tuntutan perlawanan pada fase ini... Maka bisa jadi Allah akan menghukum jamaah-jamaah atau para dai itu dan tidak menghukum masyarakat awam.#{1}":{"text":null,"length":0,"last_read":{"hash":"1gctzdd","at":1795258067225},"key":"Literature/faedah_140.md#Ketika di zaman kita seorang dai hanya memperhatikan dirinya sendiri dan mencari kenyamanan pribadi dengan mengesampingkan dakwahnya. Ketika ia berjuang mati-matian untuk memuaskan keegoisannya. Ketika jamaah-jamaah disibukkan dengan perkara furu' meninggalkan perkara-perkara besar. Ketika kita sibuk mengikuti pendapat-pendapat seseorang dan meninggalkan prinsip. Ketika kita sibuk dengan masalah-masalah khilafiyah dan meninggalkan prioritas tema dakwah seperti mewujudkan peribadatan, kewajiban menolong Al-Aqsha, tawanan dan orang-orang lemah serta tuntutan perlawanan pada fase ini... Maka bisa jadi Allah akan menghukum jamaah-jamaah atau para dai itu dan tidak menghukum masyarakat awam.#{1}","lines":[3,5],"size":1088,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":268,"read_hash":"1gctzdd","at":1795258088160}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_140.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_141_1.md": {"class_name":"SmartSource","last_read":{"hash":"w7wqea","at":1795258067226},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":231,"read_hash":"w7wqea","at":1795258082670}}},"path":"Literature/faedah_141_1.md","last_import":{"mtime":1794485911202,"size":697,"at":1795258067227,"hash":"w7wqea"},"outlinks":[],"blocks_data":{"#Setiap kali engkau sibuk dengan pendapat-pendapat tokoh dan meninggalkan prinsip, setiap kali engkau sibuk dengan perkara furu' dan meninggalkan ushul dan kewajiban waktu, maka ketahuilah engkau telah menjauh dari perkara yang benar.":{"text":null,"length":0,"last_read":{"hash":"w7wqea","at":1795258067226},"key":"Literature/faedah_141_1.md#Setiap kali engkau sibuk dengan pendapat-pendapat tokoh dan meninggalkan prinsip, setiap kali engkau sibuk dengan perkara furu' dan meninggalkan ushul dan kewajiban waktu, maka ketahuilah engkau telah menjauh dari perkara yang benar.","lines":[1,7],"size":602,"should_embed":false},"#Setiap kali engkau sibuk dengan pendapat-pendapat tokoh dan meninggalkan prinsip, setiap kali engkau sibuk dengan perkara furu' dan meninggalkan ushul dan kewajiban waktu, maka ketahuilah engkau telah menjauh dari perkara yang benar.#{1}":{"text":null,"length":0,"last_read":{"hash":"bjjd1v","at":1795258067226},"key":"Literature/faedah_141_1.md#Setiap kali engkau sibuk dengan pendapat-pendapat tokoh dan meninggalkan prinsip, setiap kali engkau sibuk dengan perkara furu' dan meninggalkan ushul dan kewajiban waktu, maka ketahuilah engkau telah menjauh dari perkara yang benar.#{1}","lines":[3,7],"size":365,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":255,"read_hash":"bjjd1v","at":1795258083177}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_141_1.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
