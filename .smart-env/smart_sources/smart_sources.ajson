"smart_sources:Literature/faedah_83.md": {"class_name":"SmartSource","last_read":{"hash":"4ef3z5","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":116,"read_hash":"4ef3z5","at":1793355249214}}},"path":"Literature/faedah_83.md","last_import":{"mtime":1793325233358,"size":1837,"at":1793355217196,"hash":"4ef3z5"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Aqidah irja telah meruntuhkan pemikiran daulah Islam sejak berabad-abad yang lalu dan kaum muslimin tidak mungkin akan kembali pada kejayaan peradabannya yang dahulu kecuali dengan iman dan amal perbuatan secara beriringan.":{"text":null,"length":0,"last_read":{"hash":"4ef3z5","at":1793355217193},"key":"Literature/faedah_83.md#Aqidah irja telah meruntuhkan pemikiran daulah Islam sejak berabad-abad yang lalu dan kaum muslimin tidak mungkin akan kembali pada kejayaan peradabannya yang dahulu kecuali dengan iman dan amal perbuatan secara beriringan.","lines":[1,7],"size":1508,"should_embed":false},"#Aqidah irja telah meruntuhkan pemikiran daulah Islam sejak berabad-abad yang lalu dan kaum muslimin tidak mungkin akan kembali pada kejayaan peradabannya yang dahulu kecuali dengan iman dan amal perbuatan secara beriringan.#{1}":{"text":null,"length":0,"last_read":{"hash":"b24f2g","at":1793355217193},"key":"Literature/faedah_83.md#Aqidah irja telah meruntuhkan pemikiran daulah Islam sejak berabad-abad yang lalu dan kaum muslimin tidak mungkin akan kembali pada kejayaan peradabannya yang dahulu kecuali dengan iman dan amal perbuatan secara beriringan.#{1}","lines":[3,7],"size":1280,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":128,"read_hash":"b24f2g","at":1793355248989}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_83.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
