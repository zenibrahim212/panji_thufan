"smart_sources:Literature/faedah_85.md": {"class_name":"SmartSource","last_read":{"hash":"19s1a5q","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":111,"read_hash":"19s1a5q","at":1793355248513}}},"path":"Literature/faedah_85.md","last_import":{"mtime":1793325233358,"size":1381,"at":1793355217196,"hash":"19s1a5q"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Orang yang berinfak maka manfaat infaknya akan kembali pada dirinya terlebih dahulu pertama-tama di dunia, hal itu karena infak pada orang-orang yang harus ditanggung akan membuka baginya perbendaharaan Sang Raja Allah 'azza wa jalla.":{"text":null,"length":0,"last_read":{"hash":"19s1a5q","at":1793355217193},"key":"Literature/faedah_85.md#Orang yang berinfak maka manfaat infaknya akan kembali pada dirinya terlebih dahulu pertama-tama di dunia, hal itu karena infak pada orang-orang yang harus ditanggung akan membuka baginya perbendaharaan Sang Raja Allah 'azza wa jalla.","lines":[1,9],"size":1155,"should_embed":false},"#Orang yang berinfak maka manfaat infaknya akan kembali pada dirinya terlebih dahulu pertama-tama di dunia, hal itu karena infak pada orang-orang yang harus ditanggung akan membuka baginya perbendaharaan Sang Raja Allah 'azza wa jalla.#{1}":{"text":null,"length":0,"last_read":{"hash":"1bubymz","at":1793355217193},"key":"Literature/faedah_85.md#Orang yang berinfak maka manfaat infaknya akan kembali pada dirinya terlebih dahulu pertama-tama di dunia, hal itu karena infak pada orang-orang yang harus ditanggung akan membuka baginya perbendaharaan Sang Raja Allah 'azza wa jalla.#{1}","lines":[3,9],"size":917,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":123,"read_hash":"1bubymz","at":1793355248758}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_85.md","requires_reimport":false},"task_lines":[],"tasks":{},"codebloc