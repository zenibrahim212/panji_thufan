"smart_sources:Literature/faedah_96.md": {"class_name":"SmartSource","last_read":{"hash":"9tp16p","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":125,"read_hash":"9tp16p","at":1793355249460}}},"path":"Literature/faedah_96.md","last_import":{"mtime":1793325233360,"size":400,"at":1793355217196,"hash":"9tp16p"},"outlinks":[],"metadata":{"tags":["#panji_thufan","#shalat_malam"]},"blocks_data":{"#Jihad yang dibarengi dengan shalat malam, maka dengan keduanya seorang hamba akan mencapai kedudukan yang tinggi.":{"text":null,"length":0,"last_read":{"hash":"9tp16p","at":1793355217193},"key":"Literature/faedah_96.md#Jihad yang dibarengi dengan shalat malam, maka dengan keduanya seorang hamba akan mencapai kedudukan yang tinggi.","lines":[1,7],"size":349,"should_embed":false},"#Jihad yang dibarengi dengan shalat malam, maka dengan keduanya seorang hamba akan mencapai kedudukan yang tinggi.#{1}":{"text":null,"length":0,"last_read":{"hash":"1k4bkjf","at":1793355217193},"key":"Literature/faedah_96.md#Jihad yang dibarengi dengan shalat malam, maka dengan keduanya seorang hamba akan mencapai kedudukan yang tinggi.#{1}","lines":[3,7],"size":232,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":135,"read_hash":"1k4bkjf","at":1793355249657}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_96.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_98_1.md": {"class_name":"SmartSource","last_read":{"hash":"nxkgar","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":130,"read_hash":"nxkgar","at":1793355249460}}},"path":"Literature/faedah_98_1.md","last_import":{"mtime":1793325233360,"size":952,"at":1793355217196,"hash":"nxkgar"},"outlinks":[],"metadata":{"tags":["#panji_thufan","#shalat_malam"]},"blocks_data":{"#Tahajud adalah amalan tarbiyah paling agung yang dengannnya seorang muslim mentarbiyah dirinya. Dan diharapkan bagi yang melaziminya tidak jatuh kedalam jurang-jurrang fitnah, disamping adanya penempaan jiwa untuk mencapai kedudukan tinggi, penjernihan akal dan tarbiyah dalam ketersembunyian.":{"text":null,"length":0,"last_read":{"hash":"nxkgar","at":1793355217193},"key":"Literature/faedah_98_1.md#Tahajud adalah amalan tarbiyah paling agung yang dengannnya seorang muslim mentarbiyah dirinya. Dan diharapkan bagi yang melaziminya tidak jatuh kedalam jurang-jurrang fitnah, disamping adanya penempaan jiwa untuk mencapai kedudukan tinggi, penjernihan akal dan tarbiyah dalam ketersembunyian.","lines":[1,7],"size":816,"should_embed":false},"#Tahajud adalah amalan tarbiyah paling agung yang dengannnya seorang muslim mentarbiyah dirinya. Dan diharapkan bagi yang melaziminya tidak jatuh kedalam jurang-jurrang fitnah, disamping adanya penempaan jiwa untuk mencapai kedudukan tinggi, penjernihan akal dan tarbiyah dalam ketersembunyian.#{1}":{"text":null,"length":0,"last_read":{"hash":"h7zofy","at":1793355217193},"key":"Literature/faedah_98_1.md#Tahajud adalah amalan tarbiyah paling agung yang dengannnya seorang muslim mentarbiyah dirinya. Dan diharapkan bagi yang melaziminya tidak jatuh kedalam jurang-jurrang fitnah, disamping adanya penempaan jiwa untuk mencapai kedudukan tinggi, penjernihan akal dan tarbiyah dalam ketersembunyian.#{1}","lines":[3,7],"size":519,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":