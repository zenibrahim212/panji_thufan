"smart_sources:Literature/faedah_63.md": {"class_name":"SmartSource","last_read":{"hash":"11ag4ix","at":1793355217204},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":93,"read_hash":"11ag4ix","at":1793355247737}}},"path":"Literature/faedah_63.md","last_import":{"mtime":1792821764474,"size":323,"at":1793355217204,"hash":"11ag4ix"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Syiar aktivis sosial adalah: Beramal dan memberi serta berharap pahalanya disisi Allah.":{"text":null,"length":0,"last_read":{"hash":"11ag4ix","at":1793355217204},"key":"Literature/faedah_63.md#Syiar aktivis sosial adalah: Beramal dan memberi serta berharap pahalanya disisi Allah.","lines":[1,7],"size":272,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":106,"read_hash":"11ag4ix","at":1793355247839}}}},"#Syiar aktivis sosial adalah: Beramal dan memberi serta berharap pahalanya disisi Allah.#{1}":{"text":null,"length":0,"last_read":{"hash":"hieje9","at":1793355217204},"key":"Literature/faedah_63.md#Syiar aktivis sosial adalah: Beramal dan memberi serta berharap pahalanya disisi Allah.#{1}","lines":[3,7],"size":181,"should_embed":false}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_63.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_91.md": {"class_name":"SmartSource","last_read":{"hash":"4atqel","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":117,"read_hash":"4atqel","at":1793355249214}}},"path":"Literature/faedah_91.md","last_import":{"mtime":1793325233359,"size":1962,"at":1793355217196,"hash":"4atqel"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Fokus dai hanya pada sisi kelembutan dari perikehidupan Nabi shallallahu 'alaihi wassalam saja justru melalaikan sisi lainnya dan menguburkannya. Dan memberikan gambaran yang tidak utuh mengenai kepribadian Nabi shallallahu 'alaihi wassalam dan kepribadian mukmin yang diinginkan dan diridhai Allah 'azza wa jalla. Selain itu, sikap ini memancing kelakuan kaum munafik dan orang-orang bodoh untuk meremehkan kaum muslimin.":{"text":null,"length":0,"last_read":{"hash":"4atqel","at":1793355217193},"key":"Literature/faedah_91.md#Fokus dai hanya pada sisi kelembutan dari perikehidupan Nabi shallallahu 'alaihi wassalam saja justru melalaikan sisi lainnya dan menguburkannya. Dan memberikan gambaran yang tidak utuh mengenai kepribadian Nabi shallallahu 'alaihi wassalam dan kepribadian mukmin yang diinginkan dan diridhai Allah 'azza wa jalla. Selain itu, sikap ini memancing kelakuan kaum munafik dan orang-orang bodoh untuk meremehkan kaum muslimin.","lines":[1,7],"size":1602,"should_embed":false},"#Fokus dai hanya pada sisi kelembutan dari perikehidupan Nabi shallallahu 'alaihi wassalam saja justru melalaikan sisi lainnya dan menguburkannya. Dan memberikan gambaran yang tidak utuh mengenai kepribadian Nabi shallallahu 'alaihi wassalam dan kepribadian mukmin yang diinginkan dan diridhai Allah 'azza wa jalla. Selain itu, sikap ini memancing kelakuan kaum munafik dan orang-orang bodoh untuk meremehkan kaum muslimin.#{1}":{"text":null,"length":0,"last_read":{"hash":"171rtys","at":1793355217193},"key":"Literature/faedah_91.md#Fokus dai hanya pada sisi kelembutan dari perikehidupan Nabi shallallahu 'alaihi wassalam saja justru melalaikan sisi lainnya dan menguburkannya. Dan memberikan gambaran yang tidak utuh mengenai kepribadian Nabi shallallahu 'alaihi wassalam dan kepribadian mukmin yang diinginkan dan diridhai Allah 'azza wa jalla. Selain itu, sikap ini memancing kelakuan kaum munafik dan orang-orang bodoh untuk meremehkan kaum muslimin.#{1}","lines":[3,7],"size":1176,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":129,"read_hash":"171rtys","at":1793355248989}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_91.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_92.md": {"class_name":"SmartSource","last_read":{"hash":"xwf3gd","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":108,"read_hash":"xwf3gd","at":1793355248513}}},"path":"Literature/faedah_92.md","last_import":{"mtime":1793325233359,"size":1158,"at":1793355217196,"hash":"xwf3gd"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Mengatur urusan manusia dan memantau urusan mereka merupakan salah satu pintu dari pintu-pintu jihad dan cabang dari cabang-cabang iman dan merupakan jalan para Nabi.":{"text":null,"length":0,"last_read":{"hash":"xwf3gd","at":1793355217193},"key":"Literature/faedah_92.md#Mengatur urusan manusia dan memantau urusan mereka merupakan salah satu pintu dari pintu-pintu jihad dan cabang dari cabang-cabang iman dan merupakan jalan para Nabi.","lines":[1,7],"size":946,"should_embed":false},"#Mengatur urusan manusia dan memantau urusan mereka merupakan salah satu pintu dari pintu-pintu jihad dan cabang dari cabang-cabang iman dan merupakan jalan para Nabi.#{1}":{"text":null,"length":0,"last_read":{"hash":"bektp9","at":1793355217193},"key":"Literature/faedah_92.md#Mengatur urusan manusia dan memantau urusan mereka merupakan salah satu pintu dari pintu-pintu jihad dan cabang dari cabang-cabang iman dan merupakan jalan para Nabi.#{1}","lines":[3,7],"size":775,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":142,"read_hash":"bektp9","at":1793355249801}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_92.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_92_1.md": {"class_name":"SmartSource","last_read":{"hash":"153akfs","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":132,"read_hash":"153akfs","at":1793355249882}}},"path":"Literature/faedah_92_1.md","last_import":{"mtime":1793325233359,"size":1281,"at":1793355217196,"hash":"153akfs"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Kerja-kerja sosial dan kemasyarakatan membutuhkan kelapangan dada serta sikap pertengahan antara marah dan ridha. Adapun kelapangan dada, dengannya kamu bisa menanggung beban kesukaran dan memimpin manusia. Sedangkan pertengahan dalam marah dan ridha, dengan tidak selalu bersikap tegas sepanjang waktu yang pada akhirnya menumbangkanmu, dan tidak pula bersikap lembek sepanjang waktu sehingga orang-orang bodoh menginjak-injakmu.":{"text":null,"length":0,"last_read":{"hash":"153akfs","at":1793355217193},"key":"Literature/faedah_92_1.md#Kerja-kerja sosial dan kemasyarakatan membutuhkan kelapangan dada serta sikap pertengahan antara marah dan ridha. Adapun kelapangan dada, dengannya kamu bisa menanggung beban kesukaran dan memimpin manusia. Sedangkan pertengahan dalam marah dan ridha, dengan tidak selalu bersikap tegas sepanjang waktu yang pada akhirnya menumbangkanmu, dan tidak pula bersikap lembek sepanjang waktu sehingga orang-orang bodoh menginjak-injakmu.","lines":[1,7],"size":1107,"should_embed":false},"#Kerja-kerja sosial dan kemasyarakatan membutuhkan kelapangan dada serta sikap pertengahan antara marah dan ridha. Adapun kelapangan dada, dengannya kamu bisa menanggung beban kesukaran dan memimpin manusia. Sedangkan pertengahan dalam marah dan ridha, dengan tidak selalu bersikap tegas sepanjang waktu yang pada akhirnya menumbangkanmu, dan tidak pula bersikap lembek sepanjang waktu sehingga orang-orang bodoh menginjak-injakmu.#{1}":{"text":null,"length":0,"last_read":{"hash":"ubaw0t","at":1793355217193},"key":"Literature/faedah_92_1.md#Kerja-kerja sosial dan kemasyarakatan membutuhkan kelapangan dada serta sikap pertengahan antara marah dan ridha. Adapun kelapangan dada, dengannya kamu bisa menanggung beban kesukaran dan memimpin manusia. Sedangkan pertengahan dalam marah dan ridha, dengan tidak selalu bersikap tegas sepanjang waktu yang pada akhirnya menumbangkanmu, dan tidak pula bersikap lembek sepanjang waktu sehingga orang-orang bodoh menginjak-injakmu.#{1}","lines":[3,7],"size":673,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":143,"read_hash":"ubaw0t","at":1793355249801}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_92_1.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_94_1.md": {"class_name":"SmartSource","last_read":{"hash":"vr5jgk","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":123,"read_hash":"vr5jgk","at":1793355249460}}},"path":"Literature/faedah_94_1.md","last_import":{"mtime":1793325233360,"size":233,"at":1793355217196,"hash":"vr5jgk"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Berniaga di pasar membutuhkan kezuhudan dan ketakwaan.":{"text":null,"length":0,"last_read":{"hash":"vr5jgk","at":1793355217193},"key":"Literature/faedah_94_1.md#Berniaga di pasar membutuhkan kezuhudan dan ketakwaan.","lines":[1,7],"size":199,"should_embed":false},"#Berniaga di pasar membutuhkan kezuhudan dan ketakwaan.#{1}":{"text":null,"length":0,"last_read":{"hash":"12zrk8l","at":1793355217193},"key":"Literature/faedah_94_1.md#Berniaga di pasar membutuhkan kezuhudan dan ketakwaan.#{1}","lines":[3,7],"size":141,"should_embed":false}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_94_1.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
"smart_sources:Literature/faedah_94.md": {"class_name":"SmartSource","last_read":{"hash":"p5pwbf","at":1793355217193},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":133,"read_hash":"p5pwbf","at":1793355249882}}},"path":"Literature/faedah_94.md","last_import":{"mtime":1793325233360,"size":1996,"at":1793355217196,"hash":"p5pwbf"},"outlinks":[],"metadata":{"tags":["#panji_thufan"]},"blocks_data":{"#Mendirikan pasar, menghidupkannya dan menertibkannya sebagaimana yang Allah merupakan suatu kewajiban dari kewajiban-kewajiban kaum muslimin. Maka tidak sepatutnya berdagang di pasar kita kecuali orang-orang yang memahami fikihnya.":{"text":null,"length":0,"last_read":{"hash":"p5pwbf","at":1793355217193},"key":"Literature/faedah_94.md#Mendirikan pasar, menghidupkannya dan menertibkannya sebagaimana yang Allah merupakan suatu kewajiban dari kewajiban-kewajiban kaum muslimin. Maka tidak sepatutnya berdagang di pasar kita kecuali orang-orang yang memahami fikihnya.","lines":[1,11],"size":1617,"should_embed":false},"#Mendirikan pasar, menghidupkannya dan menertibkannya sebagaimana yang Allah merupakan suatu kewajiban dari kewajiban-kewajiban kaum muslimin. Maka tidak sepatutnya berdagang di pasar kita kecuali orang-orang yang memahami fikihnya.#{1}":{"text":null,"length":0,"last_read":{"hash":"1zg4fm","at":1793355217193},"key":"Literature/faedah_94.md#Mendirikan pasar, menghidupkannya dan menertibkannya sebagaimana yang Allah merupakan suatu kewajiban dari kewajiban-kewajiban kaum muslimin. Maka tidak sepatutnya berdagang di pasar kita kecuali orang-orang yang memahami fikihnya.#{1}","lines":[3,11],"size":1382,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":144,"read_hash":"1zg4fm","at":1793355249801}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_94.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"o