"smart_sources:Literature/faedah_10.md": {"class_name":"SmartSource","last_read":{"hash":"ivzmcu","at":1793355217166},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":20,"read_hash":"ivzmcu","at":1793355244605}}},"path":"Literature/faedah_10.md","last_import":{"mtime":1791672281008,"size":2107,"at":1793355217166,"hash":"ivzmcu"},"outlinks":[],"metadata":{"tags":["#panji_thufan","#madrasah_jihad"]},"blocks_data":{"#Di antara pelajaran dalam madrasah jihad: bersandar pada Allah, menyerahkan segala urusan pada-Nya, mendidik tidak takut pada musuh, memperlihatkan ketakutan dan kepengecutan ahlu batil berhadapan dengan ahlu haq berserta pengikutnya, madrasah kesabaran, madrasah itsar (pengorbanan dan mengutamakan orang lain), madrasah idad, madrasah ujian fisabilillah, madrasah keteguhan mujahid, madrasah untuk memutus semua keterkaitan duniawi dan para makhluk.":{"text":null,"length":0,"last_read":{"hash":"ivzmcu","at":1793355217166},"key":"Literature/faedah_10.md#Di antara pelajaran dalam madrasah jihad: bersandar pada Allah, menyerahkan segala urusan pada-Nya, mendidik tidak takut pada musuh, memperlihatkan ketakutan dan kepengecutan ahlu batil berhadapan dengan ahlu haq berserta pengikutnya, madrasah kesabaran, madrasah itsar (pengorbanan dan mengutamakan orang lain), madrasah idad, madrasah ujian fisabilillah, madrasah keteguhan mujahid, madrasah untuk memutus semua keterkaitan duniawi dan para makhluk.","lines":[1,8],"size":1753,"should_embed":false},"#Di antara pelajaran dalam madrasah jihad: bersandar pada Allah, menyerahkan segala urusan pada-Nya, mendidik tidak takut pada musuh, memperlihatkan ketakutan dan kepengecutan ahlu batil berhadapan dengan ahlu haq berserta pengikutnya, madrasah kesabaran, madrasah itsar (pengorbanan dan mengutamakan orang lain), madrasah idad, madrasah ujian fisabilillah, madrasah keteguhan mujahid, madrasah untuk memutus semua keterkaitan duniawi dan para makhluk.#{1}":{"text":null,"length":0,"last_read":