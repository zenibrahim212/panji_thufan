"smart_sources:Literature/faedah_119.md": {"class_name":"SmartSource","last_read":{"hash":"fyg26l","at":1795258067186},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":209,"read_hash":"fyg26l","at":1795258075086}}},"path":"Literature/faedah_119.md","last_import":{"mtime":1793620758884,"size":1179,"at":1795258067186,"hash":"fyg26l"},"outlinks":[],"metadata":{"tags":["#ulama_qaidun","#islam_agama_dan_negara"]},"blocks_data":{"#Semua pengalaman kehidupan para Nabi adalah pengalaman ulama yang memimpin umat manusia. Sepanjang sejarah Islam tidak ditemukan model ulama yang membatasi dirinya berputar pada kitab-kitab dan catatan pinggirnya tanpa interaksi pada masyarakat dan menegakkan urusan politik negara. Barang siapa yang tidak demikian maka bahaya yang ia timbulkan lebih besar dari pada manfaatnya.":{"text":null,"length":0,"last_read":{"hash":"fyg26l","at":1795258067186},"key":"Literature/faedah_119.md#Semua pengalaman kehidupan para Nabi adalah pengalaman ulama yang memimpin umat manusia. Sepanjang sejarah Islam tidak ditemukan model ulama yang membatasi dirinya berputar pada kitab-kitab dan catatan pinggirnya tanpa interaksi pada masyarakat dan menegakkan urusan politik negara. Barang siapa yang tidak demikian maka bahaya yang ia timbulkan lebih besar dari pada manfaatnya.","lines":[1,7],"size":1028,"should_embed":false},"#Semua pengalaman kehidupan para Nabi adalah pengalaman ulama yang memimpin umat manusia. Sepanjang sejarah Islam tidak ditemukan model ulama yang membatasi dirinya berputar pada kitab-kitab dan catatan pinggirnya tanpa interaksi pada masyarakat dan menegakkan urusan politik negara. Barang siapa yang tidak demikian maka bahaya yang ia timbulkan lebih besar dari pada manfaatnya.#{1}":{"text":null,"length":0,"last_read":{"hash":"1krmn1y","at":1795258067186},"key":"Literature/faedah_119.md#Semua pengalaman kehidupan para Nabi adalah pengalaman ulama yang memimpin umat manusia. Sepanjang sejarah Islam tidak ditemukan model ulama yang membatasi dirinya berputar pada kitab-kitab dan catatan pinggirnya tanpa interaksi pada masyarakat dan menegakkan urusan politik negara. Barang siapa yang tidak demikian maka bahaya yang ia timbulkan lebih besar dari pada manfaatnya.#{1}","lines":[3,7],"size":645,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":233,"read_hash":"1krmn1y","at":1795258076101}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_119.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
