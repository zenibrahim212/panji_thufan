"smart_sources:Literature/faedah_137.md": {"class_name":"SmartSource","last_read":{"hash":"17znp49","at":1795258067220},"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":240,"read_hash":"17znp49","at":1795258087174}}},"path":"Literature/faedah_137.md","last_import":{"mtime":1794483755438,"size":1168,"at":1795258067221,"hash":"17znp49"},"outlinks":[],"blocks_data":{"#Alangkah agungnya surat Makiyah. Alangkah besarnya kebutuhan kita untuk mentadaburinya dan merenung sejenak meresapi pengaruh agung dalam menancapkan keimanan dan memperkokoh keyakinan. Terutama karena surat Makiyah turun pada fase kelemahan dan penyiksaan, namun sarat dengan makna ketinggian iman dan ketentraman atas kesudahan kaum mukminin di dunia dan akhirat.":{"text":null,"length":0,"last_read":{"hash":"17znp49","at":1795258067220},"key":"Literature/faedah_137.md#Alangkah agungnya surat Makiyah. Alangkah besarnya kebutuhan kita untuk mentadaburinya dan merenung sejenak meresapi pengaruh agung dalam menancapkan keimanan dan memperkokoh keyakinan. Terutama karena surat Makiyah turun pada fase kelemahan dan penyiksaan, namun sarat dengan makna ketinggian iman dan ketentraman atas kesudahan kaum mukminin di dunia dan akhirat.","lines":[1,6],"size":977,"should_embed":false},"#Alangkah agungnya surat Makiyah. Alangkah besarnya kebutuhan kita untuk mentadaburinya dan merenung sejenak meresapi pengaruh agung dalam menancapkan keimanan dan memperkokoh keyakinan. Terutama karena surat Makiyah turun pada fase kelemahan dan penyiksaan, namun sarat dengan makna ketinggian iman dan ketentraman atas kesudahan kaum mukminin di dunia dan akhirat.#{1}":{"text":null,"length":0,"last_read":{"hash":"1dbqcqn","at":1795258067220},"key":"Literature/faedah_137.md#Alangkah agungnya surat Makiyah. Alangkah besarnya kebutuhan kita untuk mentadaburinya dan merenung sejenak meresapi pengaruh agung dalam menancapkan keimanan dan memperkokoh keyakinan. Terutama karena surat Makiyah turun pada fase kelemahan dan penyiksaan, namun sarat dengan makna ketinggian iman dan ketentraman atas kesudahan kaum mukminin di dunia dan akhirat.#{1}","lines":[3,6],"size":608,"should_embed":true,"embedding":{"history":[],"default":{"mf_ccarbz":{"file":"mf_ccarbz","file_i":263,"read_hash":"1dbqcqn","at":1795258086162}}}}},"block_embedding_selection":{"version":2,"min_chars":200,"max_input_chars":1894,"source_key":"Literature/faedah_137.md","requires_reimport":false},"task_lines":[],"tasks":{},"codeblock_ranges":[],"outlinks_version":2},
